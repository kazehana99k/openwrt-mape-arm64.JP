config forward 'web'
    option enabled  '1'
    option iface    'mape'
    option name     'Web server'
    option proto    'tcp'
    option src_port '4096'
    option dest_ip  '192.168.1.10'
    option dest_port '80'

config forward 'ssh'
    option enabled  '1'
    option iface    'mape'
    option name     'SSH'
    option proto    'tcp'
    option src_port '4097'
    option dest_ip  '192.168.1.10'
    option dest_port '22'
